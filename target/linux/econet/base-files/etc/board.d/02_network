#!/bin/sh

. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

econet_setup_interfaces()
{
  local board="$1"

  case "$board" in
  # --- Cut-Down Extender Enclosures (Only 2 physical rear ports exposed) ---
  "zyxel,wx3100-t0" | "zyxel,wx5600-t0")
    # Groups the dual ports (1G or 2.5G) into a single management bridge
    ucidef_set_interfaces_lan_wan "lan1 lan2" ""
    ;;

  # --- Standard Gateways & Advanced 5600 Multi-Gig series (4xLAN + 1xWAN) ---
  "zyxel,dx3300-t0" | "zyxel,ex3300-t0" | \
  "zyxel,dx3301-t0" | "zyxel,ex3301-t0" | \
  "zyxel,ex5600-t0" | "zyxel,ex5601-t0" | "zyxel,ex5600-t1" | "zyxel,ex5601-t1" | \
  "zyxel,vmg3625-t50b" | "zyxel,vmg8623-t50b" | "zyxel,emg3525-t50b" | "zyxel,emg5523-t50b" | \
  "zyxel,vmg3927-t50k" | "zyxel,vmg8825-t50k" | "zyxel,emg5723-t50k")
    # Map ports 1-4 into LAN (regardless of speed mix) and route the combo port to WAN
    ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
    ;;

  # --- Legacy Target Fallback (Preserves Original Developer Logic) ---
  *)
    ucidef_set_interface_lan "eth0"
    ;;
  esac
}

econet_setup_macs()
{
  local board="$1"
  local lan_mac=""
  local wan_mac=""
  local label_mac=""

  case "$board" in
  # --- Legacy Huawei Node: Preserved exactly as written ---
  huawei,hg2821t-u)
    local conffile="/tmp/configuration_a/factory.conf"
    lan_mac=$(get_mac_ascii "$conffile" brmac)
    wan_mac=$(get_mac_ascii "$conffile" internetmac)
    label_mac=$wan_mac
    ;;

  # --- Zyxel Fleet User-Space Fallback ---
  "zyxel,"*)
    if [ -f "/sys/bus/nvmem/devices/romfile0/cells/mac_ethernet" ]; then
       # Read directly from the newly operational active NVMEM sysfs cell
       lan_mac=$(hexdump -v -e '1/1 "%02x:"' /sys/bus/nvmem/devices/romfile0/cells/mac_ethernet | sed 's/:$//')
    else
       # Fallback to the bootloader partition space if NVMEM is un-instantiated
       lan_mac=$(mtd_get_mac_binary "bootloader" 0x40)
    fi
    ;;
  esac

  [ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
  [ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
  [ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces "$board"
econet_setup_macs "$board"
board_config_flush

exit 0

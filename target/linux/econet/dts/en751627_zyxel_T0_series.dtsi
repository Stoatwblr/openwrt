 * ============================================================================
 * INTERMEDIATE SERIES SUMMARY: ZYXEL EN751627 WI-FI 6 (T0) GENERATION
 * ============================================================================
 * Core Baseline: Inherits en751627_zyxel.dtsi
 * Wireless Driver Target: MediaTek mt79 Modern Multi-User MIMO Frameworks
 * Sub-Fleet Scope: Governs 330x Mainstream, 3100 Extender, and 560x Premium tiers
 */

#include "en751627_zyxel.dtsi"


&usb {
	status = "okay";
};

/* target/linux/econet/dts/en751627_zyxel_T0_series.dtsi */
&pcie0 {
    status = "okay";
    pcie-bridge {
        wifi@0,0 {
            compatible = "mediatek,mt7915";
            reg = <0x0000 0 0 0 0>;
            /* Point cleanly to the early block window inside romfile */
            mediatek,mtd-eeprom = <&nand 0x040000>; 
        };
    };
};

&pcie1 {
    status = "okay";
    pcie-bridge {
        wifi@0,0 {
            compatible = "mediatek,mt7915";
            reg = <0x0000 0 0 0 0>;
            /* Offset cleanly inside the 0x400000 size limit of the partition */
            mediatek,mtd-eeprom = <&nand 0x042000>; 
        };
    };
};

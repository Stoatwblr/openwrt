 * ============================================================================
 * SUBSERIES SPECIFICATION: T50B MOTHERBOARD LINE
 * ============================================================================
 * Parent Fleet: en751627_zyxel_T50_series.dtsi
 * Targets: EMG3525, VMG3625, EMG5523, VMG8623
 * Constraints: Restricts generic XHCI blocks to drop USB 3.0 transceiver paths.
 */

#include "en751627_zyxel_T50_series.dtsi"



&usb {
	/* Target configuration matching the standard MTK XHCI controller layout */
	usb3-ports {
		/delete-node/ port@1; /* Erase unpopulated hardware paths */
	};
};

&pcie0 {
        status = "okay";

        pcie-bridge {
                #address-cells = <3>;
                #size-cells = <2>;
                device_type = "pci";

                wifi@0,0 {
                        compatible = "mediatek,mt7615";
                        reg = <0x0000 0 0 0 0>;
                        /* Points to the 5GHz calibration data segment */
                        mediatek,mtd-eeprom = <&nand 0x040000>;
                };
        };
};

 * ============================================================================
 * SUBSERIES SPECIFICATION: T50B MOTHERBOARD LINE
 * ============================================================================
 * Parent Fleet: en751627_zyxel_T50_series.dtsi
 * Targets: EMG3525, VMG3625, EMG5523, VMG8623
 * Constraints: Restricts generic XHCI blocks to drop USB 3.0 transceiver paths.
 */

#include "en751627_zyxel_T50_series.dtsi"



&usb {
	/* Target configuration matching the standard MTK XHCI controller layout */
	usb3-ports {
		/delete-node/ port@1; /* Erase unpopulated hardware paths */
	};
};


/* Lane 1: The dedicated physical 2.4GHz MT7603 Wireless Chipset link */
&pcie0 {
	status = "okay";

	pcie-bridge {
		#address-cells = <3>;
		#size-cells = <2>;
		device_type = "pci";

		wifi@0,0 {
			compatible = "mediatek,mt7603";
			reg = <0x0000 0 0 0 0>;

      /* Mainline NVMEM cellular tracking mapping array */
      nvmem-cells = <&wifi_eeprom_2g>, <&mac_wlan_2g>;
      nvmem-cell-names = "eeprom", "mac-address";
 			
			/* Relative phandle tells the legacy driver to pull from offset 0x600 */
			mediatek,mtd-eeprom = <&romfile 0x600>;
		};
	};
};

/* Lane 2: The dedicated physical 5GHz MT76x2 Wireless Chipset link */
&pcie1 {
	status = "okay";

	pcie-bridge {
		#address-cells = <3>;
		#size-cells = <2>;
		device_type = "pci";

		wifi@0,0 {
			compatible = "mediatek,mt76x2";
			reg = <0x0000 0 0 0 0>;
			
      /* Mainline NVMEM cellular tracking mapping array */
      nvmem-cells = <&wifi_eeprom_5g>, <&mac_wlan_5g>;
      nvmem-cell-names = "eeprom", "mac-address";

			/* Relative phandle tells the legacy driver to pull from offset 0x4600 */
			mediatek,mtd-eeprom = <&romfile 0x4600>;
		};
	};
}

#include "en751627.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	voip_slic: slic-hook {
		compatible = "skyworks,si32280";
		status = "disabled";
	};

	dsl_modem: dsl-hook {
		compatible = "econet,en7556n";
		status = "disabled";
	};

  chosen {
		bootargs = "earlycon=uart8250,mmio32,0x1fbf0000 console=ttyS0,115200 ";
	};

	gpio-keys {
		compatible = "gpio-keys";
		button_reset: reset {
			label = "reset";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
		button_wps: wps {
			label = "wps";
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
		button_wifi: wifi {
			label = "wifi";
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WLAN>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: power_green {
			label = "green:power";
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		led_power_red: power_red {
			label = "red:power";
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		};
		led_internet_green: internet_green {
			label = "green:internet";
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		};
		led_internet_red: internet_red {
			label = "red:internet";
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		};
		led_wps_green: wps_green {
			label = "green:wps";
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		};
		led_lan_green: lan_green {
			label = "green:lan";
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
		led_wlan_2g: wlan_2g {
			label = "green:wlan2g";
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		};
		led_wlan_5g: wlan_5g {
			label = "green:wlan5g";
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		};
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bootloader: partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};

    romfile: partition@40000 {
      label = "romfile";
      reg = <0x40000 0x400000>;
      read-only;

      nvmem-layout {
        compatible = "fixed-layout";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Factory Hardcoded Identification Identifiers */
        board_id: board-id@0 { reg = <0x0 0x20>; type = "string"; };
        serial_number: serial@20 { reg = <0x20 0x20>; type = "string"; };

        /* The Uniform Triple MAC Matrix */
        mac_ethernet: mac@40 { reg = <0x40 0x6>; };
        mac_wlan_2g:  mac@46 { reg = <0x46 0x6>; };
        mac_wlan_5g:  mac@4c { reg = <0x4c 0x6>; };
        mac_wan:      mac@52 { reg = <0x52 0x6>; }; /* Fully tracks the 4th address */

        /* Shared EEPROM Data Targets */
        wifi_eeprom_2g: eeprom@600  { reg = <0x600 0x1000>; };
        wifi_eeprom_5g: eeprom@4600 { reg = <0x4600 0x1000>; };
      };
    };

		kernel: partition@80000 {
			label = "kernel";
			reg = <0x80000 0x400000>; /* Matches the script's exact 4MB PAD_ROOTFS_OFFSET_TO limit */
		};

		rootfs: partition@480000 {
			label = "rootfs";
			reg = <0x480000 0x3600000>; /* File system block lands precisely on this physical sector boundary */
		};

		kernel_alt: partition@3a80000 {
			label = "kernel_alt";
			reg = <0x3a80000 0x400000>;
		};

		rootfs_alt: partition@3e80000 {
			label = "rootfs_alt";
			reg = <0x3e80000 0x3500000>;
		};
  };
};

/* Bind standard parent drivers to these unified cells */
&ethernet {
  nvmem-cells = <&mac_ethernet>;
  nvmem-cell-names = "mac-address";
	status = "okay";

	mac@0 {
		status = "okay";
		nvmem-cells = <&mac_ethernet>;
		nvmem-cell-names = "mac-address";
	};

	mac@1 {
		status = "okay";
		nvmem-cells = <&mac_wan>;
		nvmem-cell-names = "mac-address";
	};
};

&mdio0 {
  status = "okay";
};

&switch0 {
  status = "okay";
};

/* Attach wireless interfaces directly to their dedicated cells */
&pcie0 {
    status = "okay";
};

&pcie1 {
    status = "okay";
};

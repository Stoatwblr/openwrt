#include "en751627.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	voip_slic: slic-hook {
		compatible = "skyworks,si32280";
		status = "disabled";
	};

	dsl_modem: dsl-hook {
		compatible = "econet,en7556n";
		status = "disabled";
	};

  chosen {
		bootargs = "earlycon=uart8250,mmio32,0x1fbf0000 console=ttyS0,115200 ";
	};

	gpio-keys {
		compatible = "gpio-keys";
		button_reset: reset {
			label = "reset";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
		button_wps: wps {
			label = "wps";
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
		button_wifi: wifi {
			label = "wifi";
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WLAN>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: power_green {
			label = "green:power";
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		led_power_red: power_red {
			label = "red:power";
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		};
		led_internet_green: internet_green {
			label = "green:internet";
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		};
		led_internet_red: internet_red {
			label = "red:internet";
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		};
		led_wps_green: wps_green {
			label = "green:wps";
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		};
		led_lan_green: lan_green {
			label = "green:lan";
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
		led_wlan_2g: wlan_2g {
			label = "green:wlan2g";
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		};
		led_wlan_5g: wlan_5g {
			label = "green:wlan5g";
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		};
	};
};

&nand {
	status = "okay";
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};
		partition@40000 {
			label = "kernel";
			reg = <0x40000 0x400000>;
		};  
		partition@440000 {
			label = "rootfs";
			reg = <0x440000 0x3600000>; /* Symmetrical Target 1: 54MB */
		};
		partition@3A40000 {
			label = "kernel_alt";
			reg = <0x3A40000 0x400000>;
		};
		rootfs_alt_partition: partition@3E40000 {
			label = "rootfs_alt";
			reg = <0x3E40000 0x3600000>; /* Symmetrical Target 2: 54MB */
		};
	};
};

/* Reference the internal ethernet engine handle label natively */
&ethernet {
	status = "okay";
};


/* Override only the physical wiring properties for the Zyxel board ports */
&switch_ports {
	port@0 {
		status = "okay";
		label = "lan1";
	};

	port@1 {
		status = "okay";
		label = "lan2";
	};

	port@2 {
		status = "okay";
		label = "lan3";
	};

	port@3 {
		status = "okay";
		label = "lan4";
	};

	port@4 {
		status = "okay";
		label = "wan";
	};
};

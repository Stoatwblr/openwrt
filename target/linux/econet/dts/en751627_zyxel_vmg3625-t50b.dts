#include "en751627_zyxel_T50B_subseries.dtsi"

/ {
	model = "Zyxel VMG3625-T50B";
	compatible = "zyxel,vmg3625-t50b", "econet,en751627";
};

&voip_slic {
	status = "disabled"; /* Unpopulated hardware voice block */
};

&dsl_modem {
	status = "okay"; /* Enable the open-ended VDSL copper modem engine loop */
};

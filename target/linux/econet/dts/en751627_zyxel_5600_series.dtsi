 * ============================================================================
 * INTERMEDIATE SERIES SUMMARY: ZYXEL EN751627 WI-FI 6 (5600) GENERATION
 * ============================================================================
 * Core Baseline: Inherits en751627_zyxel.dtsi
 * Wireless Driver Target: MediaTek mt79 Modern Multi-User MIMO Frameworks
 * Sub-Fleet Scope: Governs 330x Mainstream, 3100 Extender, and 560x Premium tiers
 */

#include "en751627_zyxel.dtsi"


&usb {
  /* USB 3.0 super-speed controller paths remain fully uninhibited */
  /* Target configuration matching the standard MTK XHCI controller layout */
};

&pcie0 {
	status = "okay";

        pcie-bridge {
                #address-cells = <3>;
                #size-cells = <2>;
                device_type = "pci";

                wifi@0,0 {
                        compatible = "mediatek,mt7916";
                        reg = <0x0000 0 0 0 0>;
                        /* Direct driver to extract its mapping out of the romfile partition block */
                        mediatek,mtd-eeprom = <&nand 0x040600>; 
                };
        };
};

&pcie1 {
	status = "okay";

        pcie-bridge {
                #address-cells = <3>;
                #size-cells = <2>;
                device_type = "pci";

                wifi@0,0 {
                        compatible = "mediatek,mt7915";
                        reg = <0x0000 0 0 0 0>;
                        /* Match the relative offset structure for the second external radio card */
                        mediatek,mtd-eeprom = <&nand 0x044600>;
                };
        };
};

